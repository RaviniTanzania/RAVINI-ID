# RAVINI Production Environment Variables Configuration
# Copy this file to .env and configure production credentials.

# Port configuration (Hardcoded to 3000 by platform)
PORT=3000
NODE_ENV=production

# Database Configuration
# Local SQLite database path (WAL mode enabled)
DATABASE_PATH=data/ravini_production.sqlite
# Optional external PostgreSQL / Cloud SQL URL (if provisioned)
DATABASE_URL=

# WebRTC & Realtime Infrastructure
# Google STUN is enabled by default: stun:stun.l.google.com:19302
# Optional TURN server credentials for symmetric NAT relay
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Cloud Object Storage (S3 / GCS)
# If not configured, falls back to persistent local storage at /data/uploads/
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GCS_BUCKET_NAME=
GCS_PROJECT_ID=

# Authentication & Security
JWT_SECRET=ravini_production_secret_key_change_in_production
SESSION_EXPIRY_HOURS=72

# Telco Payment Gateways (Tanzania)
# Lipa Namba Manual Verification is active by default
VODACOM_MPESA_API_KEY=
TIGO_PESA_API_KEY=
AIRTEL_MONEY_API_KEY=
